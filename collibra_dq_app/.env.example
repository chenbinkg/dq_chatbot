# Copy to .env and fill in real values. Never commit the real .env file.

# --- Super-user login allowlist for the local Gradio app ---
# Comma-separated username:password pairs.
SUPERUSER_CREDENTIALS=alice:changeme,bob:changeme

# --- J&J GenAI Gateway (Claude via API key) ---
JNJ_GENAI_API_KEY=

# --- Collibra CDQ APAC ---
CDQ_BASE_URL_APAC=https://jnj-apac-comm-dq.collibra.jnj.com
CDQ_USERNAME_APAC=
CDQ_PASSWORD_APAC=

# --- Collibra CDQ CN ---
CDQ_BASE_URL_CN=https://jnj-cn-comm-dq.collibra.jnj.com
CDQ_USERNAME_CN=
CDQ_PASSWORD_CN=

# --- Redshift sampling (used by the sample_table_data tool) ---
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_DBNAME=idiscover
# Only needed if the two known clusters change; defaults are hardcoded in redshift_connections.py
REDSHIFT_CONN1_HOST=itx-adj-prod-dwh.cyl6xqaf72ng.ap-southeast-1.redshift.amazonaws.com
REDSHIFT_CONN2_HOST=itx-adj-prod-dwh2.cyl6xqaf72ng.ap-southeast-1.redshift.amazonaws.com

# --- PostgreSQL (curated dataset tagging in public.dqm_business_unit_mapping) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DQM_BU_MAPPING_TABLE=public.dqm_business_unit_mapping
# Optional overrides for the chatbot's own audit tables (see chat_store.py)
DQM_CHAT_HISTORY_TABLE=public.dqm_chatbot_chat_history
DQM_CHANGE_HISTORY_TABLE=public.dqm_chatbot_change_history

# --- Atlassian MCP (Jira / Confluence / Bitbucket tools) ---
MCP_ATLASSIAN_URL=https://atlassian-mcp.xena.dev/mcp/
X_ATLASSIAN_JIRA_URL=
X_ATLASSIAN_JIRA_PERSONAL_TOKEN=
X_ATLASSIAN_USERNAME=
X_ATLASSIAN_READ_ONLY_MODE=true
X_ATLASSIAN_ENABLE_XRAY=false
# X_ATLASSIAN_CONFLUENCE_URL=
# X_ATLASSIAN_CONFLUENCE_PERSONAL_TOKEN=
# X_ATLASSIAN_BITBUCKET_URL=
# X_ATLASSIAN_BITBUCKET_PERSONAL_TOKEN=

# --- AWS Access (used by boto3 for the list_s3_objects/sample_s3_file tools; read-only,
# no write/delete S3 permissions should be granted to this key) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
